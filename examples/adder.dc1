; This program adds a number 4-bit number to another every four cycles.

; DCBA: first number
; LKJI: second number
; Y: output update register
; Z: carry bit
; PO: program counter

; add second number to first number 16/4=4 times
#cycles 16
#regs DCBA, LKJI, Y, Z, PO
#pre DCBA=3, LKJI=3
#out dec, DCBA, Y

; output result every four cycles
set Y OP!Y
res Y OPY

; add first bits if PO = 0
set A !P!O !A!IZ
set A !P!O !AI!Z
set A !P!O A!I!Z
set A !P!O AIZ

set Z !P!O AI
set Z !P!O AZ
set Z !P!O IZ

pres A !P!O


; add second bits if PO = 1
set B !PO !B!JZ
set B !PO !BJ!Z
set B !PO B!J!Z
set B !PO BJZ

set Z !PO BJ
set Z !PO BZ
set Z !PO JZ

pres B !PO


; add third bits if PO = 2
set C P!O !C!KZ
set C P!O !CK!Z
set C P!O C!K!Z
set C P!O CKZ

set Z P!O CK
set Z P!O CZ
set Z P!O KZ

pres C P!O


; add fourth bits if PO = 3
set D PO !D!LZ
set D PO !DL!Z
set D PO D!L!Z
set D PO DLZ

set Z PO DL
set Z PO DZ
set Z PO LZ

pres D PO


; increment PO
set O !O
pres O
set P O!P
res P OP


pres Z
