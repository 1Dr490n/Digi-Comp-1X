; This program adds a number 4-bit number to another every four cycles.

; DCBA: first number
; LKJI: second number
; Y: output update register
; Z: carry bit
; PO: program counter

; add second number to first number 16/4=4 times
#cycles 16
#regs DCBA, LKJI, Y, Z, PO
#pre DCBA=3, LKJI=4
#out dec, DCBA, Y

; import the standard macro library
#macros test.py

; output result every four cycles
set Y OP!Y
res Y OPY


; add first bits if PO = 0
; use @add macro to add A to I if !P!O, using Z as a carry bit.
@add(A, I, Z, !P!O)

;;
	this is a multiline comment. The macro above expands to this:
set A !P!O !A!IZ
set A !P!O !AI!Z
set A !P!O A!I!Z
set A !P!O AIZ

set Z !P!O AI
set Z !P!O AZ
set Z !P!O IZ

pres A !P!O
pres Z
;;

; add second bits if PO = 1
@add(B, J, Z, !PO)

; add third bits if PO = 2
@add(C, K, Z, P!O)

; add fourth bits if PO = 3
@add(D, L, Z, PO)

; increment PO
set O !O
pres O
set P O!P
res P OP

