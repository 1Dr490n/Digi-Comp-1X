#cycles 60
#regs FEDCBA, nmLKJI, VUTSRQ, Y, Z, MPO
#pre FEDCBA=0, nmLKJI=1
#out dec, FEDCBA, Y
#macros test.py

set Y M!PO!Y
res Y M!POY

@add(A, I, Z, !M!P!O)
@add(B, J, Z, !M!PO)
@add(C, K, Z, !MP!O)
@add(D, L, Z, !MPO)
@add(E, m, Z, M!P!O)
@add(F, n, Z, M!PO)

set O !O
pres O
set P !M!PO
res P OP
set M OP
res M MO

@set(VUTSRQ, FEDCBA, !M!P!O)
@pres(VUTSRQ, !M!P!O)

@set(nmLKJI, VUTSRQ, M!PO)
@pres(nmLKJI, M!PO)